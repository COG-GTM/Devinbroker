# ShadowBroker — Docker Compose Environment Variables
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# ── Required for backend container ─────────────────────────────
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AIS_API_KEY=

# Admin key for the Settings panel and /api/settings + /api/system endpoints.
# Those endpoints are DISABLED while this is empty. Use a long random value,
# e.g. `openssl rand -hex 32`, and enter it in the dashboard's ADMIN KEY field.
ADMIN_KEY=

# ── Optional ───────────────────────────────────────────────────

# LTA (Singapore traffic cameras) — leave blank to skip
# LTA_ACCOUNT_KEY=

# Override the backend URL the frontend uses (leave blank for auto-detect)
# NEXT_PUBLIC_API_URL=http://192.168.1.50:8000
